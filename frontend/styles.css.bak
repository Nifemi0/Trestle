:root{--ink:#171313;--burg:#7f1d35;--burg2:#a52d4b;--paper:#f5f0e9;--muted:#776f6b;--line:#ded6ce;--white:#fffaf4}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font-family:'Albert Sans',sans-serif}.shell{max-width:1180px;margin:auto;padding:0 34px}.topbar{height:92px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line)}.brand{display:flex;align-items:center;gap:10px;color:var(--ink);text-decoration:none;font-family:Poppins;font-size:21px;font-weight:700;letter-spacing:-.8px}.brand-mark{display:grid;place-items:center;background:var(--burg);color:#fff;width:30px;height:30px;border-radius:50%;font-size:18px}.network-pill,.live-tag{font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:1.2px}.network-pill{border:1px solid var(--line);border-radius:99px;padding:10px 14px;color:var(--muted)}.pulse{display:inline-block;width:7px;height:7px;border-radius:50%;background:#2b9b68;margin-right:7px;box-shadow:0 0 0 4px #2b9b6820}.hero{padding:94px 0 68px;max-width:720px}.eyebrow{font-size:11px;letter-spacing:2px;font-weight:800;color:var(--burg);margin-bottom:14px}.hero h1{font:800 clamp(48px,8vw,88px)/.99 Poppins;margin:0;letter-spacing:-4px}.hero h1 em{font-style:normal;color:var(--burg)}.lede{font-size:19px;line-height:1.55;color:var(--muted);max-width:550px;margin:28px 0}.hero-actions{display:flex;align-items:center;gap:26px}.button{border:0;border-radius:6px;padding:16px 20px;font:700 14px 'Albert Sans';cursor:pointer}.primary{background:var(--burg);color:#fff;transition:.2s}.primary:hover{background:var(--burg2);transform:translateY(-1px)}.button span{margin-left:17px;font-size:18px}.text-link{color:var(--ink);font-weight:700;font-size:14px;text-decoration:underline;text-underline-offset:5px}.bridge-card{background:var(--ink);color:var(--white);border-radius:12px;padding:32px;max-width:760px;box-shadow:0 20px 60px #17131318}.card-head,.section-title{display:flex;justify-content:space-between;align-items:flex-start}.bridge-card h2,.activity h2{font:700 25px Poppins;margin:0;letter-spacing:-1px}.live-tag{color:#85d4a7;padding-top:6px}.flip-route{display:block;margin:24px 0 -17px auto;border:0;background:none;color:#df9aac;font:600 12px 'Albert Sans';cursor:pointer}.route-grid{display:grid;grid-template-columns:1fr 48px 1fr;align-items:center;margin:34px 0 27px}.chain-box{border:1px solid #ffffff20;padding:20px;border-radius:8px;background:#ffffff08}.chain-box label,.amount-row label{display:block;font-size:10px;letter-spacing:1.5px;color:#a9a09d;font-weight:700;margin-bottom:13px}.chain-name{display:flex;align-items:center;gap:10px;font-weight:700}.chain-name strong{font-size:11px;color:#a9a09d;font-weight:500;margin-left:auto}.chain-box small{display:block;color:#9e9692;margin:9px 0 0 38px}.chain-icon{width:28px;height:28px;display:grid;place-items:center;border-radius:50%;font:700 13px Poppins}.bot{background:#f0c1a0;color:#432218}.arb{background:#8eb5ff;color:#15274f}.route-arrow{text-align:center;color:#df9aac;font-size:25px}.amount-row{display:flex;align-items:end;gap:22px;margin-bottom:23px}.amount-input{display:flex;align-items:center;border-bottom:1px solid #ffffff60;padding-bottom:7px}.amount-input input{width:180px;background:none;border:0;outline:0;color:var(--white);font:600 30px Poppins}.amount-input span{font-size:13px;color:#aaa09b}.balance{margin-left:auto;text-align:right;color:#a9a09d;font-size:12px}.balance strong{display:block;color:var(--white);font-size:14px;margin-top:6px}.dest-balance-label{display:block;color:#df9aac;font-size:11px;margin-top:15px}.full{width:100%;text-align:left}.hint{color:#968e89;font-size:12px;margin:15px 0 0}.transfer-status{margin-top:22px;padding-top:16px;border-top:1px solid #ffffff18}.status-step{display:flex;align-items:center;gap:10px;color:#8f8782;font-size:12px;margin:9px 0}.status-step span{display:grid;place-items:center;width:20px;height:20px;border:1px solid #ffffff30;border-radius:50%;font-size:10px}.status-step.active{color:#df9aac}.status-step.active span{border-color:#df9aac}.status-step.done{color:#85d4a7}.status-step.done span{border-color:#85d4a7}.stats{display:flex;gap:0;max-width:760px;padding:34px 0 90px}.stats div{flex:1;border-right:1px solid var(--line);padding:0 25px}.stats div:first-child{padding-left:0}.stats div:last-child{border:0}.stats span{display:block;color:var(--muted);font-size:12px;margin-bottom:9px}.stats strong{font:600 17px Poppins}.activity{max-width:760px;padding-bottom:90px}.refresh{background:none;border:0;color:var(--burg);font-weight:700;cursor:pointer}.activity-list{border-top:1px solid var(--line)}.activity-item{display:flex;align-items:center;gap:14px;padding:18px 0;border-bottom:1px solid var(--line);font-size:13px}.activity-item .route{font-weight:700;flex:1}.activity-item .status{color:#2b9b68;font-weight:700}.activity-item .time{color:var(--muted);font-size:12px}.tx{color:var(--burg);text-decoration:none;font-size:12px}.skeleton{height:55px;border-bottom:1px solid var(--line);background:linear-gradient(90deg,transparent,#e8dfd7,transparent);animation:shimmer 1.3s infinite}.skeleton.short{width:75%}@keyframes shimmer{to{opacity:.35}}footer{display:flex;justify-content:space-between;border-top:1px solid var(--line);padding:25px 0 35px;color:var(--muted);font-size:12px}footer a{color:var(--ink);margin-left:20px;text-decoration:none;font-weight:600}@media(max-width:640px){.shell{padding:0 20px}.topbar{height:72px}.hero{padding:65px 0 52px}.hero h1{letter-spacing:-2.5px}.lede{font-size:16px}.bridge-card{padding:22px}.flip-route{display:block;margin:24px 0 -17px auto;border:0;background:none;color:#df9aac;font:600 12px 'Albert Sans';cursor:pointer}.route-grid{grid-template-columns:1fr 25px 1fr}.chain-box{padding:14px 10px}.chain-name{gap:6px;font-size:13px}.chain-name strong{display:none}.chain-box small{margin-left:0;font-size:11px}.amount-row{display:block}.balance{margin:18px 0 0;text-align:left}.stats{padding-bottom:65px}.stats div{padding:0 12px}.stats div:first-child{padding-left:0}.stats strong{font-size:14px}.activity-item{flex-wrap:wrap}.activity-item .route{min-width:65%}footer{display:block;line-height:2}footer span{display:block}footer a{margin:0 15px 0 0}}
